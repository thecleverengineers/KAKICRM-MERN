{
  "name": "kaki-crm-modern",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modern React, Node.js and MongoDB rebuild of the KAKI CRM.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "migrate:legacy": "npm run build:server && node dist/server/scripts/migrateLegacySql.js",
    "verify:legacy": "npm run build:server && node dist/server/scripts/verifyLegacyMigration.js",
    "check:migrated-login": "npm run build:server && node dist/server/scripts/checkMigratedLogin.js",
    "seed:admin": "npm run build:server && node dist/server/scripts/seedAdmin.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.8",
    "bcryptjs": "^2.4.3",
    "bson": "^6.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
